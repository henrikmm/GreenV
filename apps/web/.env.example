# Base URL for the GreenV API.
#
# Leave it empty for local development: vite.config.js proxies /api to the API, which makes the
# browser talk to a single origin. That matters more than it looks - the session rides in cookies,
# and a cookie sent from :5173 to another host is a third-party cookie, which Safari and Firefox
# block outright.
#
# Set it only when the dashboard is served from the API's own registrable domain.
VITE_GREENV_API_URL=
