# Dependencies and build output are never committed. The lockfiles are the record
# of what CI and the development machines both installed; the trees they produce
# are not. Committing one cost this repository 49.9 MB before it was noticed.
node_modules/
dist/
build/
.vite/
*.tsbuildinfo

# JVM
.gradle/
!gradle/wrapper/gradle-wrapper.jar
*.class

# Python
__pycache__/
*.pyc
*.egg-info/
.venv/
venv/

# Flutter and Dart
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
*.iml

# Secrets and machine-local configuration
.env
.env.local
*.local.json
!.claude/settings.local.json.example

# Agent worktrees. They are checkouts of this same repository, so git records each one as a
# gitlink and carries a broken submodule wherever the branch goes. They also hold absolute paths
# from whichever git created them, which is why a worktree made under WSL breaks `git commit` for
# the Windows client in the same repository.
.claude/worktrees/

# Terraform working data, local state and saved plans. The dependency lock is
# tracked so CI and developer machines resolve the same provider versions.
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraform.tfstate.lock.info
*.tfvars
!*.tfvars.example
infrastructure/**/backend.tf
infrastructure/**/backend.r2.hcl

# Session scratch. Cheap to redraw, never evidence anybody else can check.
.inspect/
.runs/

# Editor and OS
.DS_Store
.idea/
*.swp
