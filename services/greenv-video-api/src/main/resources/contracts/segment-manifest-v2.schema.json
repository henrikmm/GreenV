{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://greenv.local/contracts/segment-manifest-v2.schema.json",
  "title": "SegmentManifest.v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "sessionId", "segmentIndex", "sourceGeneration",
    "telemetryGeneration", "durationMillis", "encodedFrameCount",
    "goodLocationFrames", "degradedLocationFrames", "unavailableLocationFrames",
    "locationSampleCount", "motionSampleCount", "frameMetadataObjectKey",
    "frameMetadataSha256", "frameMetadataBytes", "sampledFrames",
    "sourceDeleted", "createdAt"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "sessionId": { "type": "string", "format": "uuid" },
    "segmentIndex": { "type": "integer", "minimum": 0 },
    "sourceGeneration": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "telemetryGeneration": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "durationMillis": { "type": "integer", "minimum": 1, "maximum": 30000 },
    "encodedFrameCount": { "type": "integer", "minimum": 1 },
    "goodLocationFrames": { "type": "integer", "minimum": 0 },
    "degradedLocationFrames": { "type": "integer", "minimum": 0 },
    "unavailableLocationFrames": { "type": "integer", "minimum": 0 },
    "locationSampleCount": { "type": "integer", "minimum": 0 },
    "motionSampleCount": { "type": "integer", "minimum": 0 },
    "frameMetadataObjectKey": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "frameMetadataSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "frameMetadataBytes": { "type": "integer", "minimum": 1 },
    "sampledFrames": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["index", "fileName", "timestampSeconds", "sizeBytes", "sha256"],
        "properties": {
          "index": { "type": "integer", "minimum": 0 },
          "fileName": { "type": "string", "pattern": "^frame-[0-9]{4}\\.jpg$" },
          "timestampSeconds": { "type": "number", "minimum": 0 },
          "sizeBytes": { "type": "integer", "minimum": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "sourceDeleted": { "type": "boolean" },
    "createdAt": { "type": "string", "format": "date-time" }
  }
}
