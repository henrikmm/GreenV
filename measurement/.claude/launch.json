{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "app",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "app"
      ],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "verge-phone",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "VERGE_PHONE_INTAKE=1",
        "npm",
        "run",
        "dev",
        "--prefix",
        "app"
      ],
      "port": 5173
    }
  ]
}
