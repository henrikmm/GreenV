bucket = "greenv-terraform-state-replace-me"
key    = "environments/mvp/terraform.tfstate"
region = "auto"

endpoints = {
  s3 = "https://replace-with-cloudflare-account-id.r2.cloudflarestorage.com"
}

use_path_style              = true
skip_credentials_validation = true
skip_region_validation      = true
skip_requesting_account_id  = true
skip_s3_checksum            = true
use_lockfile                = true
